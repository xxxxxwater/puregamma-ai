# Core
APP_ENV=development
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INITIAL_LAUNCH_MODE=true
CREDIT_USAGE_ENFORCED=true
ENTITLEMENTS_ENFORCED=true
API_RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
NEXT_PUBLIC_INITIAL_LAUNCH_MODE=true
APP_DOMAIN=puregamma.ai
API_DOMAIN=api.puregamma.ai
POSTGRES_PASSWORD=
WORKER_CONCURRENCY=2
LOG_LEVEL=info
JWT_SECRET=change-me
AUTH_ALLOW_DEMO_FALLBACK=false
NEXT_PUBLIC_API_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
