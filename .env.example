RSS_SYNC_ENABLED=true
RSS_CONFIG_PATH=config/rss_sources.yaml
RSS_SYNC_INTERVAL=15
RSS_REQUEST_TIMEOUT=10
FIN_TWIT_CONFIG_PATH=config/fintwit_accounts.yaml
FIN_TWIT_SYNC_INTERVAL=30
X_API_BASE_URL=https://api.x.com/2
X_SYNC_INTERVAL=30
X_SEARCH_QUERY=(BTC OR ETH OR SOL OR HYPE) -is:retweet
X_LIST_ID=
X_REQUEST_BUDGET_PER_SYNC=4
DATA_RETENTION_DAYS=30
BINANCE_PUBLIC_DATA_ENABLED=true
DEFILLAMA_FREE_ENABLED=true
THE_GRAPH_ENABLED=true
ONCHAIN_RPC_ENABLED=true
DATA_SYNC_WORKER_ENABLED=true
RSS_SYNC_INTERVAL_MINUTES=15
BINANCE_SYNC_INTERVAL_MINUTES=2
DEFILLAMA_SYNC_INTERVAL_MINUTES=180
ONCHAIN_SYNC_INTERVAL_MINUTES=15
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_MAX_RESPONSE_BYTES=5000000

# Optional reviewed subgraphs. Keep disabled in config until an endpoint is set.
UNISWAP_V3_SUBGRAPH_URL=

# Bloomberg import, reserved for enterprise/private deployments.
BLOOMBERG_ENABLED=false
BLOOMBERG_MODE=disabled
BLOOMBERG_API_URL=
BLOOMBERG_API_KEY=
BLOOMBERG_LICENSE_STATUS=unlicensed
BLOOMBERG_REDISTRIBUTION_ALLOWED=false
BLOOMBERG_DATA_DIR=
BLOOMBERG_SFTP_HOST=
BLOOMBERG_SFTP_USER=
BLOOMBERG_SFTP_PRIVATE_KEY=

# NautilusTrader research layer, live trading remains disabled by default.
NAUTILUS_ENABLED=false
NAUTILUS_DATA_DIR=./data/nautilus
NAUTILUS_LIVE_TRADING_ENABLED=false
NAUTILUS_ALLOW_LIVE_ORDER=false
NAUTILUS_EXECUTION_MODE=paper
NAUTILUS_ALLOW_WITHDRAWAL=false
NAUTILUS_ALLOW_TRANSFER=false
NAUTILUS_RUNTIME_URL=http://localhost:8090
NAUTILUS_RUNTIME_SECRET=change-me-runtime-secret
NAUTILUS_RUNTIME_TIMEOUT_SECONDS=10
NAUTILUS_RUNTIME_STATE_DB=./nautilus_runtime.sqlite3
NAUTILUS_RUNTIME_SYNC_INTERVAL_SECONDS=60
NAUTILUS_RECONCILE_INTERVAL_MINUTES=5
NAUTILUS_MARKET_REFRESH_INTERVAL_SECONDS=15
NAUTILUS_PUBLIC_MARKET_DATA_ENABLED=true
NAUTILUS_HYPERLIQUID_PUBLIC_URL=https://api.hyperliquid.xyz
NAUTILUS_COINBASE_PUBLIC_URL=https://api.exchange.coinbase.com
NAUTILUS_MARKET_DATA_TIMEOUT_SECONDS=5
NAUTILUS_MARKET_DATA_CACHE_TTL_SECONDS=5
NAUTILUS_MARKET_DATA_FAILURE_THRESHOLD=3
NAUTILUS_MARKET_DATA_RECOVERY_SECONDS=60
HYPERLIQUID_WALLET_ADDRESS=
COINBASE_ADVANCED_API_KEY=
COINBASE_ADVANCED_API_SECRET=

# Deribit V4 read-only options intelligence (public API, no key required)
DERIBIT_PUBLIC_URL=https://www.deribit.com
DERIBIT_TIMEOUT_SECONDS=8
DERIBIT_DETAIL_LIMIT=8
DERIBIT_CACHE_TTL_SECONDS=30

# Security and observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
AUDIT_LOG_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# DeepSeek Harness Research (additive layer, all OFF by default)
# The harness-runner is a low-trust research sandbox. It can never create
# orders or reach the database, Redis, Nautilus runtime, or production .env.
# ---------------------------------------------------------------------------
HARNESS_RESEARCH_ENABLED=false
HARNESS_RESEARCH_ADMIN_ONLY=true
HARNESS_RESEARCH_NETWORK_ENABLED=false
HARNESS_RESEARCH_ALLOW_CODE=false
HARNESS_GLOBAL_CONCURRENCY=2
HARNESS_MAX_RUNS_PER_USER_PER_DAY=3
HARNESS_RUN_TIMEOUT_SECONDS=720
HARNESS_RUN_MAX_BUDGET_CREDITS=150

# Automated trading foundation (additive, all OFF by default).
# LIVE auto trading is not implemented; even with these flags set it cannot
# run without an additional deployment-level approval marker.
AUTO_TRADING_MANDATES_ENABLED=false
AUTO_TRADING_PAPER_ENABLED=false
AUTO_TRADING_SHADOW_ENABLED=false
AUTO_TRADING_LIVE_ENABLED=false
AUTO_TRADING_DEPLOYMENT_LIVE_APPROVED=false

# ---- LIVE Trading Control Plane (EVERY gate defaults to OFF) ----
# See docs/live-trading/FEATURE_FLAGS.md — LIVE is never enabled by a single
# variable. All of the following must line up plus DB-level approvals,
# healthy broker connection, kill switches off and reconciliation OK.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_DEPLOYMENT_APPROVED=false
LIVE_TRADING_PROVIDER=
LIVE_TRADING_VENUE=MOCK
LIVE_TRADING_ALLOWED_SYMBOLS=
LIVE_TRADING_GATEWAY=mock
LIVE_TRADING_ORDER_TIMEOUT_SECONDS=8
LIVE_TRADING_DEFAULT_MAX_NOTIONAL=1000
LIVE_CREDENTIAL_ENCRYPTION_KEY=
# Single-server sync budget (docs/live-trading/PRODUCTION_DEPLOYMENT.md)
LIVE_PRICE_REFRESH_INTERVAL_SECONDS=10
LIVE_BALANCE_SYNC_INTERVAL_SECONDS=45
LIVE_ORDER_SYNC_INTERVAL_SECONDS=8
LIVE_NAV_CALC_INTERVAL_SECONDS=45
LIVE_NAV_PRICE_STALE_SECONDS=60
LIVE_RECONCILIATION_HOUR_UTC=0

# Memory Service (PureGamma-owned). Models/Harness never write memory directly;
# everything goes through Memory Proposal -> Policy -> consent -> audit.
MEMORY_SERVICE_ENABLED=false
MEMORY_AUTO_ACCEPT_LOW_RISK=true
MEMORY_SUMMARY_TTL_DAYS=30
MEMORY_RECENT_MESSAGE_WINDOW=12
