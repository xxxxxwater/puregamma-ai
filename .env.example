# Core
APP_ENV=development
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INITIAL_LAUNCH_MODE=true
# Hidden compatibility routes; keep false until each capability has production evidence.
HIDDEN_PORTFOLIO_AI_ENABLED=false
HIDDEN_RISK_COPILOT_ENABLED=false
HIDDEN_REALTIME_ANALYTICS_ENABLED=false
HIDDEN_TRADING_MCP_ENABLED=false
CREDIT_USAGE_ENFORCED=true
ENTITLEMENTS_ENFORCED=true
API_RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
NEXT_PUBLIC_INITIAL_LAUNCH_MODE=true
# Public domain topology (production): website, SaaS, API.
MARKETING_DOMAIN=puregamma.ai
APP_DOMAIN=app.puregamma.ai
API_DOMAIN=api.puregamma.ai
POSTGRES_PASSWORD=
WORKER_CONCURRENCY=2
LOG_LEVEL=info
JWT_SECRET=change-me
AUTH_ALLOW_DEMO_FALLBACK=false

# Optional internal administrator login. Hidden from public navigation and disabled by default.
# The email must already exist in the database with role=admin.
# Generate the hash interactively with: python scripts/hash-admin-password.py
INTERNAL_ADMIN_LOGIN_ENABLED=false
INTERNAL_ADMIN_USERNAME=
INTERNAL_ADMIN_USER_EMAIL=
INTERNAL_ADMIN_PASSWORD_HASH=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/zh/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Native iOS bridge: Google redirects to the API; the API returns a one-time code to the allowlisted app URI.
MOBILE_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/mobile/google/callback
MOBILE_OAUTH_REDIRECT_URIS=puregamma://oauth/callback
MOBILE_IBKR_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/portfolio/ibkr/mobile/callback
MOBILE_PORTFOLIO_REDIRECT_URIS=puregamma://oauth/ibkr
# Sign in with Apple: private key is a server secret and must never enter the iOS bundle.
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=ai.puregamma.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Native APNs delivery. The .p8 key remains server-side.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=ai.puregamma.ios
APNS_PRIVATE_KEY=
SESSION_SECRET=change-me
ENCRYPTION_MASTER_KEY=change-me-use-a-32-byte-secret
INTERNAL_RUNTIME_SECRET=change-me-use-a-32-byte-secret
SESSION_COOKIE_NAME=pg_session
# Production must use the common parent so app.puregamma.ai can authenticate to api.puregamma.ai.
SESSION_COOKIE_DOMAIN=.puregamma.ai
REQUIRE_AUTH=false
SESSION_MAX_AGE_SECONDS=604800

# Database and Redis
DATABASE_URL=postgresql+psycopg://puregamma:puregamma@localhost:5432/puregamma
REDIS_URL=redis://localhost:6379/0
BACKTEST_ARTIFACT_DIR=./storage/backtests
WORKER_CONCURRENCY=2

# LLM
LLM_PROVIDER=mock
AGENT_GLOBAL_CONCURRENT_RUNS=20
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_LUNA_ENABLED=true
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_ALLOWED_PLANS=Max,Enterprise
OPENAI_LUNA_TIMEOUT_SECONDS=90
OPENAI_LUNA_REASONING_EFFORT=low
# Private Secretary speech-to-text and optional text-to-speech. Keys stay server-side.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
NOIZ_API_KEY=
NOIZ_VOICE_ID=183203aa0
NOIZ_ENGLISH_VOICE_ID=7bc8b578
LLM_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_TIMEOUT_SECONDS=60
# First-party OpenAI-compatible API Gateway. Keep disabled until all three
# official provider credentials and a dedicated 32+ character key pepper are set.
GATEWAY_ENABLED=false
GATEWAY_API_KEY_PEPPER=
GATEWAY_DEFAULT_RATE_LIMIT_RPM=60
GATEWAY_CATALOG_PATH=config/gateway/providers.yaml
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GATEWAY_MOONSHOT_API_KEY=
GATEWAY_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
GATEWAY_GLM_API_KEY=
GATEWAY_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_TEMPERATURE=0.2
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_RECENT_MESSAGES=12
AGENT_MAX_CONTEXT_CHARS=24000
ENABLE_MOCK_AGENT=false
ALLOW_NONREDISTRIBUTABLE_LLM_INPUT=false
# Controlled read-only web evidence fallback for Agent Chat and Private Secretary.
# PureGamma synchronized data is queried first; public search is used only when evidence is missing.
AGENT_ONLINE_RESEARCH_ENABLED=false
ONLINE_SEARCH_PROVIDER=google_news
BRAVE_SEARCH_API_KEY=
ONLINE_SEARCH_TIMEOUT_SECONDS=10
ONLINE_SEARCH_MAX_RESULTS=8
ONLINE_SEARCH_MAX_RESPONSE_BYTES=1000000

# Equity Market Data (Massive.com / FMP / Alpha Vantage)
MASSIVE_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
NASDAQ_DATA_LINK_BASE_URL=
NASDAQ_DATA_LINK_CLIENT_ID=
NASDAQ_DATA_LINK_CLIENT_SECRET=
NASDAQ_DATA_LINK_SOURCE=nasdaq
NASDAQ_DATA_LINK_OFFSET=delayed
MARKET_DATA_PROVIDER=nasdaq
ENABLE_MOCK_MARKET_DATA=false
ENABLE_MOCK_DATA_SOURCES=false

# Stripe Billing
BILLING_MODE=mock
BILLING_CHECKOUT_MODE=session
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PAYMENT_LINK_PRIMARY=https://buy.stripe.com/7sYbJ1dH6gLX2xq4EvcbC07
STRIPE_PAYMENT_LINK_PRO=
STRIPE_PAYMENT_LINK_MAX=
STRIPE_PAYMENT_LINK_ENTERPRISE=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# Notifications
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SMTP_HOST=mail.gandi.net
SMTP_PORT=587
SMTP_USER=noreply@puregamma.ai
SMTP_PASSWORD=

# iMessage relay
IMESSAGE_PROVIDER=mock
IMESSAGE_RELAY_URL=http://localhost:8787
IMESSAGE_RELAY_SECRET=
IMESSAGE_OFFICIAL_NUMBER=+14243825596
IMESSAGE_RELAY_DB=./imessage_relay.sqlite3
IMESSAGE_ENABLED_PLANS=Max,Enterprise
IMESSAGE_MAX_MESSAGE_LENGTH=3000
IMESSAGE_RATE_LIMIT_PER_USER_PER_DAY=20
IMESSAGE_VERIFICATION_PER_USER_PER_HOUR=3
IMESSAGE_VERIFICATION_PER_RECIPIENT_PER_DAY=5
IMESSAGE_REPLAY_TOLERANCE_SECONDS=300
IMESSAGE_APPLESCRIPT_PATH=

# Plaid Investments read-only portfolio connection.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_PRODUCTS=investments
PLAID_REDIRECT_URI=http://localhost:3000/portfolio
# Opt in only after approving the Transactions product's Plaid billing model.
PLAID_ENABLE_CASH_TRANSACTIONS=false
# Public API callback for signed Plaid Investments webhooks. Required to receive
# fresh holdings and investment transactions after Link and Investments Refresh.
PLAID_WEBHOOK_URL=https://api.example.com/portfolio/plaid/webhook
# Investments Refresh is billable by Plaid; rate-limit end-user refresh requests.
PLAID_INVESTMENTS_REFRESH_MINUTES=15
IBKR_API_URL=https://api.ibkr.com/v1/api
IBKR_OAUTH_AUTHORIZE_URL=
IBKR_OAUTH_TOKEN_URL=
IBKR_CLIENT_ID=
IBKR_CLIENT_SECRET=
IBKR_REDIRECT_URI=http://localhost:3000/portfolio
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Moralis is optional and server-side only. It enables verified, read-only MetaMask/EVM portfolio sync.
MORALIS_API_KEY=
MORALIS_API_URL=https://deep-index.moralis.io/api/v2.2

# Read-only account and market synchronization.
EXCHANGE_KEY_ENCRYPTION_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
HYPERLIQUID_WALLET_ADDRESS=

# Additional RPC-based on-chain data sources.
ONCHAIN_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ALCHEMY_API_KEY=
PORTFOLIO_TOKEN_ENCRYPTION_KEY=

# Market and sentiment data providers
MARKET_DATA_MODE=auto
MARKET_SNAPSHOT_CACHE_TTL_SECONDS=15
BINANCE_REST_BASE_URL=https://api.binance.com
COINBASE_REST_BASE_URL=https://api.exchange.coinbase.com
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
