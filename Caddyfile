puregamma.ai, www.puregamma.ai {
    redir https://app.puregamma.ai{uri} permanent
}
{$APP_DOMAIN} {
	encode zstd gzip
	@secretary path /zh/secretary /en/secretary
	header @secretary Cache-Control "no-store, no-cache, must-revalidate"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# X-Real-IP is the ONLY address the API trusts for rate limits and IP blocks.
	# Never copy a client-supplied CF-Connecting-IP/X-Forwarded-For value here:
	# the current origin is directly reachable, so either header can be forged.
	#
	# {client_ip} is Caddy's trusted client-address placeholder. With no CDN it is
	# the socket peer. If a CDN/reverse proxy is introduced later, configure
	# Caddy's trusted_proxies/client_ip_headers globally so this same placeholder
	# is resolved only through explicitly trusted proxy ranges.
	reverse_proxy api:8000 {
		header_up X-Real-IP {client_ip}
	}

}
