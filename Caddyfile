puregamma.ai, www.puregamma.ai {
    redir https://app.puregamma.ai{uri} permanent
}
{$APP_DOMAIN} {
	encode zstd gzip
	@secretary path /zh/secretary /en/secretary
	header @secretary Cache-Control "no-store, no-cache, must-revalidate"
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
		-Server
	}
	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# X-Real-IP is the ONLY address the API trusts for rate limits and IP blocks
	# (it ignores X-Forwarded-For, which a client can forge). It must therefore
	# carry the CLIENT address, not the edge's own.
	#
	# Two cases, in priority order:
	#   1. Behind Cloudflare: CF-Connecting-IP is set by Cloudflare itself and is
	#      trustworthy because the origin firewall admits 80/443 only from
	#      Cloudflare's ranges.
	#   2. No CDN (the current deployment): Caddy's {client_ip}, the socket peer
	#      after its own trusted_proxies handling.
	#
	# The previous rule used CF-Connecting-IP unconditionally. With no CDN in
	# front that header is absent, so the API fell back to the socket peer — the
	# Caddy container — and every visitor on earth shared one rate-limit bucket:
	# 120 requests and 20 writes per minute for the whole deployment. A map is
	# used rather than two header_up rules because header_up has no "if absent"
	# form, and the two-rule version silently lost the fallback.
	map {http.request.header.CF-Connecting-IP} {pg_client_ip} {
		"" {client_ip}
		default {http.request.header.CF-Connecting-IP}
	}
	reverse_proxy api:8000 {
		header_up X-Real-IP {pg_client_ip}
	}
}
