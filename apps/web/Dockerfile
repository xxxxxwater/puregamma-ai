FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web ./
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_INITIAL_LAUNCH_MODE=true
ARG REQUIRE_AUTH=true
ARG SESSION_COOKIE_NAME=pg_session
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_INITIAL_LAUNCH_MODE=$NEXT_PUBLIC_INITIAL_LAUNCH_MODE
ENV REQUIRE_AUTH=$REQUIRE_AUTH
ENV SESSION_COOKIE_NAME=$SESSION_COOKIE_NAME
RUN npm run build

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
