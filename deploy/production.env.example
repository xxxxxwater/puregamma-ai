# =========================================================================
# PureGamma AI - Production Environment Template
# =========================================================================
# Deploy: cp deploy/production.env.example .env
#         then fill in every empty secret below and run: bash deploy/deploy.sh
# Never commit a real .env or deploy/production.env: both are git-ignored.
# =========================================================================

# Core (production values; validate_production_settings fails the API startup
# if these are not exactly production/true)
APP_ENV=production
LOG_LEVEL=info
SITE_URL=https://app.puregamma.ai
CORS_ORIGINS=https://app.puregamma.ai
INITIAL_LAUNCH_MODE=true
CREDIT_USAGE_ENFORCED=true
ENTITLEMENTS_ENFORCED=true
API_RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=20
APP_DOMAIN=app.puregamma.ai
API_DOMAIN=api.puregamma.ai
POSTGRES_PASSWORD=
WORKER_CONCURRENCY=2

# Secrets (MUST be at least 32 characters, replace with strong random values)
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_MASTER_KEY=
INTERNAL_RUNTIME_SECRET=
SESSION_COOKIE_NAME=pg_session
SESSION_COOKIE_DOMAIN=.puregamma.ai
REQUIRE_AUTH=true
SESSION_MAX_AGE_SECONDS=604800
AUTH_ALLOW_DEMO_FALLBACK=false
# Developer-only convenience; must stay false in production.
ALLOW_MOCK_LOGIN=false
INTERNAL_ADMIN_LOGIN_ENABLED=false

# Billing must be Stripe in production (mock mode is rejected at startup).
BILLING_MODE=stripe
BILLING_CHECKOUT_MODE=session
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PAYMENT_LINK_PRIMARY=
STRIPE_PAYMENT_LINK_PRO=
STRIPE_PAYMENT_LINK_MAX=
STRIPE_PAYMENT_LINK_ENTERPRISE=
STRIPE_SUCCESS_URL=https://app.puregamma.ai/billing/success
STRIPE_CANCEL_URL=https://app.puregamma.ai/billing/cancel

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.puregamma.ai/auth/google/callback
GOOGLE_REDIRECT_URI=https://app.puregamma.ai/zh/auth/google/callback

# Database and Redis
DATABASE_URL=postgresql+psycopg://puregamma:${POSTGRES_PASSWORD}@postgres:5432/puregamma
# Redis requires a password in production (compose starts redis with --requirepass).
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
BACKTEST_ARTIFACT_DIR=/var/lib/puregamma/backtests

# LLM (main platform)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_TIMEOUT_SECONDS=60

# LLM (OpenAI / Luna for Max/Enterprise users)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_LUNA_ENABLED=false
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_LUNA_ALLOWED_PLANS=Max,Enterprise
OPENAI_LUNA_TIMEOUT_SECONDS=90
OPENAI_LUNA_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Agent settings
AGENT_GLOBAL_CONCURRENT_RUNS=20
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_TEMPERATURE=0.2
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_RECENT_MESSAGES=12
AGENT_MAX_CONTEXT_CHARS=24000
ENABLE_MOCK_AGENT=false
ALLOW_NONREDISTRIBUTABLE_LLM_INPUT=false
AGENT_ONLINE_RESEARCH_ENABLED=false

# Noiz TTS
NOIZ_API_KEY=
NOIZ_VOICE_ID=183203aa0
NOIZ_ENGLISH_VOICE_ID=7bc8b578

# Notifications
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SMTP_HOST=mail.gandi.net
SMTP_PORT=587
SMTP_USER=noreply@puregamma.ai
SMTP_PASSWORD=

# Operations alerting: webhook failures, job timeouts and relay outages are
# pushed here. At least one of OPS_ALERT_WEBHOOK / (OPS_ALERT_CHAT_ID +
# TELEGRAM_BOT_TOKEN) is recommended; without one, alerts are logged only.
OPS_ALERT_WEBHOOK=
OPS_ALERT_CHAT_ID=
# Optional error tracking (sentry-sdk must be installed in the image).
SENTRY_DSN=

# iMessage relay (keep disabled until relay Mac is ready)
IMESSAGE_PROVIDER=disabled
IMESSAGE_RELAY_URL=http://localhost:8787
IMESSAGE_RELAY_SECRET=
IMESSAGE_ENABLED_PLANS=Max,Enterprise
IMESSAGE_MAX_MESSAGE_LENGTH=3000
IMESSAGE_RATE_LIMIT_PER_USER_PER_DAY=20

# NautilusTrader (paper-only, live trading stays OFF)
NAUTILUS_RUNTIME_URL=http://nautilus-runtime:8090
NAUTILUS_RUNTIME_SECRET=
NAUTILUS_RUNTIME_TIMEOUT_SECONDS=10
NAUTILUS_RUNTIME_SYNC_INTERVAL_SECONDS=60
NAUTILUS_RECONCILE_INTERVAL_MINUTES=5
NAUTILUS_MARKET_REFRESH_INTERVAL_SECONDS=15
NAUTILUS_EXECUTION_MODE=paper
NAUTILUS_LIVE_TRADING_ENABLED=false
NAUTILUS_ALLOW_LIVE_ORDER=false
NAUTILUS_ALLOW_WITHDRAWAL=false
NAUTILUS_ALLOW_TRANSFER=false
NAUTILUS_PUBLIC_MARKET_DATA_ENABLED=true
# Testnet order submission stays OFF unless explicitly enabled (see
# docs/trading/TRADING_SAFETY.md).
NAUTILUS_TESTNET_SUBMIT_ENABLED=false

# Data providers
ENABLE_MOCK_MARKET_DATA=false
ENABLE_MOCK_DATA_SOURCES=false
DATA_SYNC_WORKER_ENABLED=true
RSS_SYNC_INTERVAL=10
FINTWIT_SYNC_INTERVAL=15
X_SYNC_INTERVAL=15

# =========================================================================
# API Gateway (relay station) - DISABLED by default, enable when provider keys are ready
# =========================================================================
GATEWAY_ENABLED=false
GATEWAY_API_KEY_PEPPER=
GATEWAY_DEFAULT_RATE_LIMIT_RPM=60
GATEWAY_CATALOG_PATH=config/gateway/providers.yaml
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GATEWAY_MOONSHOT_API_KEY=
GATEWAY_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
GATEWAY_GLM_API_KEY=
GATEWAY_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# =========================================================================
# Off-site backup (scripts/production-backup.sh) - REQUIRED in production
# =========================================================================
# S3-compatible bucket + optional endpoint; aws/rclone/s3cmd must be installed.
S3_BUCKET=
S3_ENDPOINT=
PUREGAMMA_BACKUP_DIR=/var/backups/puregamma
PUREGAMMA_BACKUP_RETENTION_DAYS=7
