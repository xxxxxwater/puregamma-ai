FROM python:3.12-slim

# Docker CLI (client only): the worker spawns ephemeral sibling containers for
# the containerized research runner via the mounted /var/run/docker.sock.
# Pinned static binary; the daemon API version is negotiated at runtime.
# The API container no longer mounts docker.sock and must not ship the CLI
# (set INSTALL_DOCKER_CLI=false for the api service build).
ARG DOCKER_CLI_VERSION=27.5.1
ARG INSTALL_DOCKER_CLI=true
# Operator-selectable PyPI mirror (e.g. https://mirrors.aliyun.com/pypi/simple/)
# for CN/HK deployments; defaults to the official index.
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN if [ "$INSTALL_DOCKER_CLI" = "true" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates curl \
      && arch="$(uname -m)" \
      && curl -fsSL "https://download.docker.com/linux/static/stable/${arch}/docker-${DOCKER_CLI_VERSION}.tgz" \
         | tar -xz -C /usr/local/bin --strip-components=1 "docker/docker" \
      && apt-get purge -y curl \
      && apt-get autoremove -y \
      && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app
COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -i "$PIP_INDEX_URL" -r /app/apps/api/requirements.txt
COPY . /app
RUN useradd --create-home --uid 10001 puregamma \
    && mkdir -p /var/lib/puregamma/backtests \
    && chown -R puregamma:puregamma /app /var/lib/puregamma
USER puregamma
EXPOSE 8000
CMD ["sh", "-c", "python -m scripts.db_migrate upgrade && exec uvicorn apps.api.main:app --host 0.0.0.0 --port 8000"]
