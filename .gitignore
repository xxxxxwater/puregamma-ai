# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp

# 2.2 release hygiene: local release snapshots and migration backups never ship
releases/
docker-compose.*.bak*
*.bak-migrate

# Playwright MCP artifacts
.playwright-mcp/

# Captured browser sessions are LIVE CREDENTIALS and must never be committed.
# Obtaining, verifying and cleaning them up: docs/verification/ADMIN_SESSION_HANDOFF.md
tests/e2e/.auth/
**/storageState*.json


# PureGamma Harness build output. `pnpm --dir harness run check` emits lib/ for
# every plugin/package; none of it is source.
harness/**/lib/
harness/pnpm-lock.yaml
