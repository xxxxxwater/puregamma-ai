{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "version": "0.1.5-rc.2",
  "private": true,
  "description": "PureGamma Harness ABI bridge for the pinned DeepSeek Harness Typert protocol",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json",
    "./types": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "scripts": { "bundle": "tsc -p tsconfig.json && tsdown --config-loader tsx" },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol-runtime": "npm:@deepseek-ai/dsh-typert-protocol@0.1.5-rc.2"
  }
}
