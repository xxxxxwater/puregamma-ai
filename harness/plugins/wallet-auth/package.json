{
  "name": "@puregamma/dsh-wallet-auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Classic SIWE / EIP-4361 wallet sign-in (nonce issue + single-use server-side message + signature verification) as a Harness Service Definition, with a fail-closed provider boundary",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./policy": {
      "types": "./lib/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/index.js.map",
    "lib/policy.js",
    "lib/policy.d.ts",
    "lib/policy.js.map"
  ],
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
