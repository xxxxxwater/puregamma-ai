{
  "name": "@puregamma/dsh-ui-backtest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Harness tool views for PureGamma backtest reads: run, status and reported metrics, labelled as simulated",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsc -p tsconfig.build.json && tsdown --config-loader tsx"
  },
  "dependencies": {
    "@puregamma/dsh-backtest": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.7-rc.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1"
  }
}
