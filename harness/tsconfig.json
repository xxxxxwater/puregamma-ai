{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "react"],
    "paths": {
      "@puregamma/dsh-market-data": ["./plugins/market-data/src/index.ts"],
      "@puregamma/dsh-portfolio": ["./plugins/portfolio/src/index.ts"],
      "@puregamma/dsh-trading": ["./plugins/trading/src/index.ts"]
    }
  },
  "include": [
    "plugins/contracts.ts",
    "plugins/catalog.ts",
    "plugins/*/src/**/*.ts"
  ],
  "exclude": [
    "plugins/*/tsdown.config.ts",
    "tsdown.node.ts",
    "../vendor/deepseek-harness/**"
  ]
}
