{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "react"],
    "paths": {
      "@puregamma/dsh-auth": ["./plugins/auth/src/index.ts"],
      "@puregamma/dsh-billing": ["./plugins/billing/src/index.ts"],
      "@puregamma/dsh-api-gateway": ["./plugins/api-gateway/src/index.ts"],
      "@puregamma/dsh-client-gateway": ["./packages/client-gateway/src/index.ts"],
      "@puregamma/dsh-data-sources": ["./plugins/data-sources/src/index.ts"],
      "@puregamma/dsh-admin": ["./plugins/admin/src/index.ts"],
      "@puregamma/dsh-notifications": ["./plugins/notifications/src/index.ts"],
      "@puregamma/dsh-market-data": ["./plugins/market-data/src/index.ts"],
      "@puregamma/dsh-portfolio": ["./plugins/portfolio/src/index.ts"],
      "@puregamma/dsh-research": ["./plugins/research/src/index.ts"],
      "@puregamma/dsh-options": ["./plugins/options/src/index.ts"],
      "@puregamma/dsh-backtest": ["./plugins/backtest/src/index.ts"],
      "@puregamma/dsh-memory": ["./plugins/memory/src/index.ts"],
      "@puregamma/dsh-secretary": ["./plugins/secretary/src/index.ts"],
      "@puregamma/dsh-skills": ["./plugins/skills/src/index.ts"],
      "@puregamma/dsh-research-runner": ["./plugins/research-runner/src/index.ts"],
      "@puregamma/dsh-trading": ["./plugins/trading/src/index.ts"],
      "@puregamma/dsh-pg-tsy-runtime": ["./plugins/pg-tsy-runtime/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "plugins/contracts.ts", "plugins/catalog.ts", "plugins/*/src/**/*.ts"],
  "exclude": ["packages/client-gateway/src/typert-host-protocol.d.ts", "packages/*/tsdown.config.ts", "plugins/*/tsdown.config.ts", "tsdown.node.ts", "../vendor/deepseek-harness/**", "../vendor/pg-tsy-core-bootstrap/**"]
}
