{
  "name": "@puregamma/harness-profile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone PureGamma Harness web profile on the pinned DeepSeek Harness runtime",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "profile": {
